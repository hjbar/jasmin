inline fn __chacha_xor_v_avx(reg u32 output input len nonce key)
{
  reg u128[16] st;
  reg u128[16] k;
  reg u128 r16 r8;

  r16 = CHACHA_R16_AVX;
  r8  = CHACHA_R8_AVX;

  st = __init_v_avx(nonce, key);

  while(len >= 256)
  { k = __copy_state_v_avx(st);
    k = __rounds_v_avx(k, r16, r8);
    k = __sum_states_v_avx(k, st);
    output, input, len = __store_xor_v_avx(output, input, len, k);
    st = __increment_counter_v_avx(st);
  }

  if(len > 0)
  { k = __copy_state_v_avx(st);
    k = __rounds_v_avx(k, r16, r8);
    k = __sum_states_v_avx(k, st);
    __store_xor_last_v_avx(output, input, len, k);
  }
}


inline fn __chacha_v_avx(reg u32 output len nonce key)
{
  reg u128[16] st;
  reg u128[16] k;
  reg u128 r16 r8;

  r16 = CHACHA_R16_AVX;
  r8  = CHACHA_R8_AVX;

  st = __init_v_avx(nonce, key);

  while(len >= 256)
  { k = __copy_state_v_avx(st);
    k = __rounds_v_avx(k, r16, r8);
    k = __sum_states_v_avx(k, st);
    output, len = __store_v_avx(output, len, k);
    st = __increment_counter_v_avx(st);
  }

  if(len > 0)
  { k = __copy_state_v_avx(st);
    k = __rounds_v_avx(k, r16, r8);
    k = __sum_states_v_avx(k, st);
    __store_last_v_avx(output, len, k);
  }
}
