u128 vec0 = 0;
u128 vec1 = (8u16)[ 0xFFFF, 0x1F1F, 0x6767, 0xABCD, 0xDCBA, 0x7676, 0xF1F1, 0x0000 ];

export
fn main_test(reg u64 x) -> reg u64 {
  reg u128 a = vec1;

  reg u128 x1 = #VSHR_8u16(a, 64); // Shifting by a multiple of 16, so by 0
  reg u128 x2 = #VSHR_8u16(a, 25); // Shifting by 9 becuase 25 mod 16 = 9

  reg u128 res = vec0;
  res +8u16= x1;
  res +8u16= x2;

  stack u16[8] tmp;
  tmp[:u128 0] = res;

  inline int i;
  for i = 0 to 8 {
    reg u64 val = (64u)tmp[i];
    x += val;
  }

  return x; // Should return 227 754 + x
}
