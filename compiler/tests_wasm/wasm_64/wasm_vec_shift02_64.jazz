u128 vec0 = 0;
u128 vec1 = (8u16)[ 9, 12, 0, 2, 7, 10, 11, 14 ];

export
fn main_test(reg u64 x) -> reg u64 {
  reg u128 a = vec1;

  reg u128 x1 = #VSHL_8u16(a, 64); // Shifting by a multiple of 16, so by 0
  reg u128 x2 = #VSHL_8u16(a, 20); // Shifting by 4 becuase 20 mod 16 = 4

  reg u128 res = vec0;
  res +8u16= x1;
  res +8u16= x2;

  stack u16[8] tmp;
  tmp[:u128 0] = res;

  inline int i;
  for i = 0 to 8 {
    reg u64 val = (64u)tmp[i];
    x += val;
  }

  return x; // Should return 1105 + x
}
