u128 vec1 = (16u8)[ 251, 239, 227, 211, 193, 179, 151, 137, 113, 109, 83, 61, 47, 23, 11, 7 ];
u128 vec2 = (16u8)[ 0, 2, 4, 1, 3, 7, 5, 6, 9, 10, 8, 12, 14, 11, 13, 15 ];

export
fn main_test(reg u64 x) -> reg u64 {
  reg u128 a = vec1;
  reg u128 b = vec2;

  reg u128 res = #SWIZZLE(a, b);

  stack u8[16] tmp;
  tmp[:u128 0] = res;

  x -= (64u)tmp[14];
  x *= (64u)tmp[13];
  x += (64u)tmp[11];
  x += (64u)tmp[10];
  x *= (64u)tmp[8];
  x -= (64u)tmp[7];
  x *= (64u)tmp[5];
  x += (64u)tmp[4];
  x += (64u)tmp[2];
  x *= (64u)tmp[1];

  // Should return ((((((((((x - 23) * 61) + 47) + 113) * 109) - 151) * 137) + 211) + 193) * 227)
  // Should return 206777251x - 4218114454
  return x;
}
