u128 vec0 = 0;
u128 vec1 = (2u64)[ 9, 12 ];

export
fn main_test(reg u64 x) -> reg u64 {
  reg u128 a = vec1;

  reg u128 x1 = #VSHL_2u64(a, 256); // Shifting by a multiple of 64, so by 0
  reg u128 x2 = #VSHL_2u64(a, 71); // Shifting by 7 becuase 71 mod 64 = 7

  reg u128 res = vec0;
  res +2u64= x1;
  res +2u64= x2;

  stack u64[2] tmp;
  tmp[:u128 0] = res;

  inline int i;
  for i = 0 to 2 {
    x += tmp[i];
  }

  return x; // Should return 2709 + x
}
