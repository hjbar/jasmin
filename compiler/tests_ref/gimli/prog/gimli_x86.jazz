require "../../../benchmarks/gimli/ref/gimli_ref.jazz"

export
fn main_test(reg u32 x) -> reg u32 {
  stack u32[12] state;
  reg u32 tmp;
  inline int i;

  for i = 0 to 12 {
    tmp = x * i;
    state[i] = (32u) tmp;
  }

  state = gimli(state);

  for i = 0 to 12 {
    x += state[i];
  }

  return x;
}
