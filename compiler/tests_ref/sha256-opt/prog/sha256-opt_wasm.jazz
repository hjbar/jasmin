require "../../../benchmarks/sha256-opt/prog/sha256-opt_wasm.jazz"

export fn main_test(reg u64 hash input input_length) -> reg u64 {
  reg u32 hash = (32u)hash;
  reg u32 input = (32u)input;
  reg u32 input_length = (32u)input_length;
  reg u32 res = jade_hash_sha256_amd64_ref(hash, input, input_length);
  reg u64 x = (64u)res;
  return x;
}
