require "sha256-opt_core_ref.jinc"

export fn jade_hash_sha256_amd64_ref(reg u64 hash input input_length) -> reg u64
{
  reg u64 r;

  _ = #init_msf();

  __sha256_ref(hash, input, input_length);
  ?{}, r = #set0();
  return r;
}

export fn main_test(reg u64 hash input input_length) -> reg u64 {
  reg u64 x = jade_hash_sha256_amd64_ref(hash, input, input_length);
  return x;
}
