
///////////////////////////////////////////////////////////////////////////////
// store 'xor' ////////////////////////////////////////////////////////////////

inline fn __update_ptr_xor_ref(reg u32 output input len, inline int n) -> reg u32, reg u32, reg u32
{
  output += n;
  input += n;
  len -= n;
  return output, input, len;
}

// 64 bytes
inline fn __store_xor_ref(reg u32 output input len, reg u32[16] k) -> reg u32, reg u32, reg u32
{
  inline int i;
  reg u64[8] kk;
  reg u64 aux;

  // i = 0 : 1 dead
  kk[0] = (64u) k[1];
  kk[0] <<= 32;
  aux = (64u)k[0];
  kk[0] ^= aux;
  kk[0] ^= [:u64 input + 8*0];

  // i = 1 : 2 dead
  kk[1] = (64u) k[3];
  kk[1] <<= 32;
  aux = (64u)k[2];
  kk[1] ^= aux;
  kk[1] ^= [:u64 input + 8*1];
  [:u64 output + 8*0] = kk[0];

  for i=2 to 8
  {
    kk[i] = (64u)((i == 7) ? k[15] : k[2*i+1]);
    kk[i] <<= 32;
    aux = (64u)k[2*i];
    kk[i] ^= aux;
    kk[i] ^= [:u64 input + 8*i];
    [:u64 output + 8*(i-1)] = kk[i-1];
  }

  [:u64 output + 8*7] = kk[7];

  output, input, len = __update_ptr_xor_ref(output, input, len, 64);

  return output, input, len;
}

inline fn __sum_states_store_xor_ref(
  reg u32 output input len,
  reg u32[16] k,
  reg u32[16] st
) -> reg u32, reg u32, reg u32
{
  inline int i;
  reg u64[8] kk;
  reg u64 aux;

  // store                                        // sum states
  // i = 0 : 1 dead
                                                  k[1] += st[1];
                                                  k[0] += st[0];
  kk[0] = (64u) k[1];
  kk[0] <<= 32;
  aux = (64u)k[0];
  kk[0] ^= aux;
  kk[0] ^= [:u64 input + 8*0];

  // i = 1 : 2 dead
                                                  k[3] += st[3];
                                                  k[2] += st[2];
  kk[1] = (64u) k[3];
  kk[1] <<= 32;
  aux = (64u)k[2];
  kk[1] ^= aux;
  kk[1] ^= [:u64 input + 8*1];
  [:u64 output + 8*0] = kk[0];

  for i=2 to 8
  {
                                                  k[2*i+1] += st[2*i+1];
                                                  k[2*i] += st[2*i];
    kk[i] = (64u)(k[2*i+1]);
    kk[i] <<= 32;
    aux = (64u)k[2*i];
    kk[i] ^= aux;
    kk[i] ^= [:u64 input + 8*i];
    [:u64 output + 8*(i-1)] = kk[i-1];
  }

  [:u64 output + 8*7] = kk[7];

  output, input, len = __update_ptr_xor_ref(output, input, len, 64);

  return output, input, len;
}

inline fn __store_xor_last_ref(reg u32 output input len, reg u32[16] k)
{
  inline int i;
  reg u64 t;
  reg u32 j len8 u;
  stack u32[16] s_k;
  reg u32 pi;

  // copy k to stack
  for i=0 to 15
  { s_k[i] = k[i]; }
  u = k[15];
  s_k[15] = u;

  // u64 at a time
  len8 = len;
  len8 >>= 3;
  j = 0;
  while(j < len8)
  {
    t = [:u64 input + 8*j];
    t ^= s_k[:u64 j];
    [:u64 output + 8*j] = t;
    j += 1;
  }
  j <<= 3;

  // u8 at a time
  while(j < len)
  {
    pi = (32u)[:u8 input + j];
    pi ^= (32u)s_k[:u8 j];
    [:u8 output + j] = (8u)pi;
    j += 1;
  }
}

///////////////////////////////////////////////////////////////////////////////
// store //////////////////////////////////////////////////////////////////////

inline fn __update_ptr_ref(reg u32 output len, inline int n) -> reg u32, reg u32
{
  output += n;
  len -= n;
  return output, len;
}

// 64 bytes
inline fn __store_ref(reg u32 output len, reg u32[16] k) -> reg u32, reg u32
{
  inline int i;
  reg u64[8] kk;
  reg u64 aux;

  // i = 0 : 1 dead
  kk[0] = (64u) k[1];
  kk[0] <<= 32;
  aux = (64u)k[0];
  kk[0] ^= aux;

  // i = 1 : 2 dead
  kk[1] = (64u) k[3];
  kk[1] <<= 32;
  aux = (64u)k[2];
  kk[1] ^= aux;
  [:u64 output + 8*0] = kk[0];

  for i=2 to 8
  {
    kk[i] = (64u)((i == 7) ? k[15] : k[2*i+1]);
    kk[i] <<= 32;
    aux = (64u)k[2*i];
    kk[i] ^= aux;
    [:u64 output + 8*(i-1)] = kk[i-1];
  }

  [:u64 output + 8*7] = kk[7];

  output, len = __update_ptr_ref(output, len, 64);

  return output, len;
}

inline fn __sum_states_store_ref(
  reg u32 output len,
  reg u32[16] k,
  reg u32[16] st
) -> reg u32, reg u32
{
  inline int i;
  reg u64[8] kk;
  reg u64 aux;

  // store                                        // sum states
  // i = 0 : 1 dead
                                                  k[1] += st[1];
                                                  k[0] += st[0];
  kk[0] = (64u) k[1];
  kk[0] <<= 32;
  aux = (64u)k[0];
  kk[0] ^= aux;

  // i = 1 : 2 dead
                                                  k[3] += st[3];
                                                  k[2] += st[2];
  kk[1] = (64u) k[3];
  kk[1] <<= 32;
  aux = (64u)k[2];
  kk[1] ^= aux;
  [:u64 output + 8*0] = kk[0];

  for i=2 to 8
  {
                                                  k[2*i+1] += st[2*i+1];
                                                  k[2*i] += st[2*i];
    kk[i] = (64u)(k[2*i+1]);
    kk[i] <<= 32;
    aux = (64u)k[2*i];
    kk[i] ^= aux;
    [:u64 output + 8*(i-1)] = kk[i-1];
  }

  [:u64 output + 8*7] = kk[7];

  output, len = __update_ptr_ref(output, len, 64);

  return output, len;
}

inline fn __store_last_ref(reg u32 output len, reg u32[16] k)
{
  inline int i;
  reg u64 t;
  reg u32 u j len8;
  stack u32[16] s_k;
  reg u32 pi;

  // copy k to stack
  for i=0 to 15
  { s_k[i] = k[i]; }
  u = k[15];
  s_k[15] = u;

  // u64 at a time
  len8 = len;
  len8 >>= 3;
  j = 0;
  while(j < len8)
  {
    t = s_k[:u64 j];
    [:u64 output + 8*j] = t;
    j += 1;
  }
  j <<= 3;

  // u8 at a time
  while(j < len)
  {
    pi = (32u)s_k[:u8 j];
    [:u8 output + j] = (8u)pi;
    j += 1;
  }
}
