inline fn __chacha_xor_ref(reg u32 output input len nonce key)
{
  reg u32[16] st;
  reg u32[16] k;

  st = __init_ref(nonce, key);

  while (len >= 64)
  { k = __copy_state_ref(st);
    k = __rounds_inline_ref(k);
    output, input, len = __sum_states_store_xor_ref(output, input, len, k, st);
    st = __increment_counter_ref(st);
  }

  if(len > 0)
  { k = __copy_state_ref(st);
    k = __rounds_inline_ref(k);
    k = __sum_states_ref(k, st);
    __store_xor_last_ref(output, input, len, k);
  }
}


inline fn __chacha_ref(reg u32 output len nonce key)
{
  reg u32[16] st;
  reg u32[16] k;

  st = __init_ref(nonce, key);

  while (len >= 64)
  { k = __copy_state_ref(st);
    k = __rounds_inline_ref(k);
    output, len = __sum_states_store_ref(output, len, k, st);
    st = __increment_counter_ref(st);
  }

  if(len > 0)
  { k = __copy_state_ref(st);
    k = __rounds_inline_ref(k);
    k = __sum_states_ref(k, st);
    __store_last_ref(output, len, k);
  }
}
