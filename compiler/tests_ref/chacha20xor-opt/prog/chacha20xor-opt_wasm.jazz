require "../../../benchmarks/chacha20xor-opt/prog/chacha20xor-opt_wasm.jazz"

export fn main_test(reg u64 output input input_length nonce key) -> reg u64 {
  reg u32 output = (32u)output;
  reg u32 input = (32u)input;
  reg u32 input_length = (32u)input_length;
  reg u32 nonce = (32u)nonce;
  reg u32 key = (32u)key;
  reg u32 res = jade_stream_chacha_chacha20_amd64_ref_xor(output, input, input_length, nonce, key);
  reg u64 x = (64u)res;
  return x;
}
