param int CHACHA_ROUNDS=20;

require "chacha_wasm.jinc"

export fn jade_stream_chacha_chacha20_amd64_ref(reg u64 stream stream_length nonce key) -> reg u64
{
  reg u64 r;
  __chacha_ref(stream, stream_length, nonce, key);
  r = 0;
  return r;
}

export fn main_test(reg u64 stream stream_length nonce key) -> reg u64 {
  reg u64 x = jade_stream_chacha_chacha20_amd64_ref(stream, stream_length, nonce, key);
  return x;
}
