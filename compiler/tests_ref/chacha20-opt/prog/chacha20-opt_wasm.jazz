export fn main_test(reg u64 stream stream_length nonce key) -> reg u64 {
  reg u32 stream = (32u)stream;
  reg u32 stream_length = (32u)stream_length;
  reg u32 nonce = (32u)nonce;
  reg u32 key = (32u)key;
  reg u32 res = jade_stream_chacha_chacha20_amd64_ref(stream, stream_length, nonce, key);
  reg u64 x = (64u)res;
  return x;
}
