inline fn compute_test(reg ptr u8[32] t1, reg ptr u16[16] t2, reg ptr u32[8] t3, reg ptr u64[4] t4)
  -> reg ptr u8[32], reg ptr u16[16], reg ptr u32[8], reg ptr u64[4], reg u32 {

  // u8..64 declarations

  reg u32 tmp8_32;
  reg u32 tmp16_32;
  reg u32 tmp32_32;
  reg u32 tmp64_32;
  reg u32 res32;

  reg u64 tmp8_64;
  reg u64 tmp16_64;
  reg u64 tmp32_64;
  reg u64 tmp64_64;
  reg u64 res64;

  reg u64 tmp1;
  reg u64 tmp2;
  reg u64 tmp3;
  reg u64 tmp4;

  reg u32 aux32;
  reg u64 aux64;

  reg u32 res;
  inline int i;


  // u8..64 computations

  tmp8_32 = 0;
  for i=0 to 32 {
    aux32 = (32u)t1[i];
    tmp8_32 += aux32;
  }

  tmp16_32 = 0;
  for i=0 to 16 {
    aux32 = (32u)t2[i];
    tmp16_32 += aux32;
  }

  tmp32_32 = 0;
  for i=0 to 8 {
    aux32 = (32u)t3[i];
    tmp32_32 += aux32;
  }

  tmp64_32 = 0;
  for i=0 to 4 {
    aux64 = t4[i];
    aux32 = (32u)aux64;
    tmp64_32 += aux32;
  }

  res32 = 0;
  res32 += tmp8_32;
  res32 *= tmp16_32;
  res32 -= tmp32_32;
  res32 *= tmp64_32;


  tmp8_64 = 0;
  for i=0 to 32 {
    aux64 = (64u)t1[i];
    tmp8_64 += aux64;
  }

  tmp16_64 = 0;
  for i=0 to 16 {
    aux64 = (64u)t2[i];
    tmp16_64 += aux64;
  }

  tmp32_64 = 0;
  for i=0 to 8 {
    aux64 = (64u)t3[i];
    tmp32_64 += aux64;
  }

  tmp64_64 = 0;
  for i=0 to 4 {
    aux64 = (64u)t4[i];
    tmp64_64 += aux64;
  }

  res64 = 0;
  res64 += tmp8_64;
  res64 *= tmp16_64;
  res64 -= tmp32_64;
  res64 *= tmp64_64;


  reg u64 tmp;

  for i=0 to 16 {
    tmp = (64u)t1[i];
    aux32 = (32u)t2[i];
    t1[i] = (8u)aux32;
    t2[i] = (16u)tmp;
  }

  for i=0 to 8 {
    tmp = (64u)t2[i];
    aux32 = (32u)t3[i];
    t2[i] = (16u)aux32;
    t3[i] = (32u)tmp;
  }

  for i=0 to 4 {
    tmp = (64u)t3[i];
    aux64 = t4[i];
    t3[i] = (32u)aux64;
    t4[i] = (64u)tmp;
  }


  tmp1 = 0;
  for i=0 to 32 {
    aux64 = (64u)t1[i];
    tmp1 += aux64;
  }

  tmp2 = 0;
  for i=0 to 16 {
    aux64 = (64u)t2[i];
    tmp2 += aux64;
  }

  tmp3 = 0;
  for i=0 to 8 {
    aux64 = (64u)t3[i];
    tmp3 += aux64;
  }

  tmp4 = 0;
  for i=0 to 4 {
    aux64 = (64u)t4[i];
    tmp4 += aux64;
  }


  // result computation

  res = res32;
  aux32 = (32u)res64;
  res += aux32;
  aux32 = (32u)tmp1;
  res *= aux32;
  aux32 = (32u)tmp2;
  res -= aux32;
  aux32 = (32u)tmp3;
  res += aux32;
  aux32 = (32u)tmp4;
  res *= aux32;

  return t1, t2, t3, t4, res;

}

export fn main_test(reg ptr u8[32] t1, reg ptr u16[16] t2, reg ptr u32[8] t3, reg ptr u64[4] t4, reg u32 x)
  -> reg ptr u8[32], reg ptr u16[16], reg ptr u32[8], reg ptr u64[4], reg u32 {

  reg u32 spill_x;
  reg u32 tmp32;
  reg u64 tmp64;
  reg u32 aux32;
  reg u64 aux64;
  reg u32 res;
  inline int i;

  spill_x = x;
  tmp32 = (32u)(spill_x * 10);
  for i=0 to 32 {
    aux32 = (32u)(tmp32 * i);
    t1[i] = (8u)aux32;
  }

  spill_x = x;
  aux32 = 10;
  tmp32 = (32u)(spill_x / aux32);
  for i=0 to 16 {
    aux32 = (32u)(tmp32 * i);
    t2[i] = (16u)aux32;
  }

  spill_x = x;
  tmp32 = (32u)(spill_x + 10);
  for i=0 to 8 {
    aux32 = (32u)(tmp32 * i);
    t3[i] = (32u)aux32;
  }

  spill_x = x;
  tmp32 = (32u)(spill_x - 10);
  tmp64 = (64u)tmp32;
  for i=0 to 4 {
    aux64 = (64u)(tmp64 * i);
    t4[i] = (64u)aux64;
  }

  t1, t2, t3, t4, res = compute_test(t1, t2, t3, t4);
  return t1, t2, t3, t4, res;

}
