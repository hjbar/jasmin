#[test = "This
is
a
multiline
  annotation  with  tabs and \" special {| |} characters
"]
export fn noop() {}

#[array = {a, b}, struct = {y = 0, z}, other_struct = { p, q = 1}]
export fn dummy() {}

param int N = 42;

#[name = N, double = N + N]
export fn expression_in_annotation() {}

export fn main_test(reg u32 x) -> reg u32 {
  noop();
  dummy();
  expression_in_annotation();

  x += N;

  return x;
}
