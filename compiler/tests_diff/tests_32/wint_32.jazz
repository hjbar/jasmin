export fn syntax() -> reg u32 {
  reg ui32 a = 42; // immediate
  reg si32 b = -5;
  reg si32 c = -b; // negation
  c *= c; // multiplication
  reg u32 x = (32u)c; // safe conversion to machine-word
  x |= (32u)a;
  return x;
}

export fn conv(reg u32 x) -> reg u32 {
  reg ui32 u = (32ui)x;
  reg si32 s = (32si)x;
  x = (32u)u;
  x |= (32u)s;
  return x;
}

export fn main_test(reg u32 x) -> reg u32 {
  reg u32 a;
  reg u32 b;
  reg u32 c;

  a = syntax();
  b = conv(x);

  x += a;
  x += b;
  x += c;

  return x;
}
