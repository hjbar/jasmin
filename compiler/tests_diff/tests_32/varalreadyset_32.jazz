inline fn consume(reg u32 x) -> reg u32 {
  if x > 0 {
    x = 0;
  }
  return x;
}

export fn main_aux(reg u32 a) -> reg u32, reg u32 {
  reg u32 x = a;
  reg u32 y = consume(x);
  return x, y;
}

export fn main_test(reg u32 a) -> reg u32 {
  reg u32 x;
  reg u32 y;
  reg u32 z;

  x, y = main_aux(a);

  z += x;
  z -= y;
  return z;
}
