inline fn min (reg u32 x, reg u32 y) -> reg u32 {
  reg u32 z;

  z = x;
  if (y < x) {
    z = y;
  }

  return z;
}

export
fn main_test(reg u32 x) -> reg u32 {
  reg u32 y;
  reg u32 z;
  reg u32 res;

  res = 0;

  y = x;
  y <<= 1;
  res += y;
  y = x;
  y <<= (8u) (1 & 31);
  res += y;
  y = x;
  z = x;
  z = min(z, 31);
  y <<= (8u) (z & 31);
  res += y;
  y = x;
  y <<= (8u) (y & 31);
  res += y;

  y = x;
  y >>u= 1;
  res += y;
  y = x;
  y >>u= (8u) (1 & 31);
  res += y;
  y = x;
  z = x;
  z = min(z, 31);
  y >>u= (8u) (z & 31);
  res += y;
  y = x;
  y >>u= (8u) (y & 31);
  res += y;

  y = x;
  y >>s= 1;
  res += y;
  y = x;
  y >>s= (8u) (1 & 31);
  res += y;
  y = x;
  z = x;
  z = min(z, 31);
  y >>s= (8u) (z & 31);
  res += y;
  y = x;
  y >>s= (8u) (y & 31);
  res += y;

  y = x;
  y <<r= 1;
  res += y;
  y = x;
  y <<r= (8u) (1 & 31);
  res += y;
  y = x;
  z = x;
  z = min(z, 31);
  y <<r= (8u) (z & 31);
  res += y;
  y = x;
  y <<r= (8u) (y & 31);
  res += y;

  y = x;
  y >>r= 1;
  res += y;
  y = x;
  y >>r= (8u) (1 & 31);
  res += y;
  y = x;
  z = x;
  z = min(z, 31);
  y >>r= (8u) (z & 31);
  res += y;
  y = x;
  y >>r= (8u) (y & 31);
  res += y;

  x = res;
  return x;
}
