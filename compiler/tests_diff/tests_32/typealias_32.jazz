

type data = u32;
type data2 = u32[4];

export fn test() -> reg data {
    reg data x;
    x = 1;
    return x;
}

namespace A {
    type x = u32;

    fn s() -> reg x {
        reg x test = 0;
        test += 1;
        return test;
    }
}

fn test2(reg A::x v, reg data2 y) -> reg A::x, reg data2 {
    reg A::x v2;
    v2 = v;
    v2+=1;
    y[0] = 1;
    return v2, y;
}


export fn main_test(reg u32 x) -> reg u32 {
  reg u32 y;
  reg u32 z;
  reg u32[4] t;

  y = test();
  z = A::s();

  x += y;
  x += z;

  t[0] = 0;
  t[1] = 1;
  t[2] = 2;
  t[3] = 3;

  x, t = test2(x, t);

  x += t[0];
  x += t[1];
  x += t[2];
  x += t[3];

  return x;
}
