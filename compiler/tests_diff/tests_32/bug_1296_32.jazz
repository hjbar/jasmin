param int x = 2;
param int y = 1 << x;

export fn load(reg ptr u8[y] v) -> reg u32 {
  reg u32 r = v[:u32 0];
  return r;
}

export fn main_test(reg u32 x) -> reg u32 {
  stack u8[y] buf;
  reg u32 res;

  buf[0] = 0x01;
  buf[1] = 0x02;
  buf[2] = 0x03;
  buf[3] = 0x04;

  res = load(buf);
  x += res;

  return x;
}
