inline fn ble::e () -> reg u32 {
    reg u32 x = 0;
    return x;
}

inline fn ble__e () -> reg u32 {
    reg u32 x = 1;
    return x;
}

export fn out() -> reg u32 {
    reg u32 x = ble::e();
    reg u32 y = ble__e();
    return y;
}

export fn main_test(reg u32 x) -> reg u32 {
  reg u32 a;
  a = out();
  x += a;
  return a;
}
