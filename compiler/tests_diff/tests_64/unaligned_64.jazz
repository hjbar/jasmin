export
fn main_aux(reg u64 x) -> reg u64 {
  stack u64[2] a;
  a[0] = x;
  a[1] = x;
  x = a.[#unaligned 2];
  return x;
}

/* This example shows that the unaligned 16-bit access is taken into account
  * when computing the alignment for the stack variable. */
#[stackalign=u16]
export
fn instack(reg u64 x) -> reg u64 {
  reg u64 r;
  stack u8[3] s;
  r = 0;
  s[0] = r;
  s.[:u16 1] = (16u)x;
  r = (64s)s[:u8 1];
  return r;
}

export
fn main_test(reg u64 x) -> reg u64 {
  reg u64 y;
  reg u64 z;

  y = main_aux(x);
  z = instack(x);

  x += y;
  x += z;

  return x;
}
