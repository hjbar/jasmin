param int N = 4;

u64[N] g = { 1, 2, 3, 4 };

export
fn all_kinds() -> reg u64 {
  inline int i;
  reg u64[N] a b;
  stack u64[N] c d;

  // Global to register
  a = #copy_64(g);
  // Register to register
  b = #copy_64(a);
  // Register to stack
  c = #copy_64(b);
  // Stack to stack
  d = #copy_64(c);
  // Stack to register
  a = #copy_64(d);

  reg u64 x;
  x = 0;
  for i = 0 to N { x += a[i]; }

  reg ptr u64[N] p;
  stack ptr u64[N] q;

  p = c;
  q = p;

  // Register to reg ptr
  p = #copy_64(a);
  // Reg ptr to stack ptr
  q = #copy_64(p);
  // Stack ptr to stack
  d = #copy_64(q);
  // Stack to reg ptr
  p = #copy_64(d);
  // Reg ptr to reg
  a = #copy_64(a);

  for i = 0 to N { x += a[i]; }

  return x;
}

export
fn slices(reg u64 x) -> reg u64 {
  inline int i;
  stack u64[4] p q;
  for i = 0 to 4 { p[i] = x; }
  for i = 0 to 2 {
    q[2 * i:2] = #copy_64(p[2 - 2 * i:2]);
  }
  x = q[1];
  return x;
}

export
fn self_copy(reg u64 x) -> reg u64 {
  inline int i;
  stack u64[3] s;
  s[0] = x;
  for i = 1 to 3 {
    s[i:1] = #copy_64(s[i - 1:1]);
  }
  x = s[2];
  return x;
}

export
fn ptr_slices() -> reg u64 {
  reg u64 x;
  reg ptr u64[2] p;
  stack u64[1] s;
  p = g[1:2];
  s = #copy_64(p[1:1]);
  x = s[0];
  return x;
}

export
fn main_test(reg u64 x) -> reg u64 {
  reg u64 y;
  reg u64 z;
  reg u64 w;

  y = all_kinds();
  z = slices(x);
  w = self_copy(y);
  x = ptr_slices();

  y = y - z;
  w = w * x;
  x = y + w;
  return x;
}
