fn inc(reg u64 a) -> reg u64 {
  a += 1;
  return a;
}

export
fn f1(reg u64 x y) -> reg u64 {
  reg u64 t u v;
  t = x;
  u = inc(t);
  v = inc(u);
  v ^= y;
  v ^= x;
  return v;
}

export
fn f2(reg u64 z) -> reg u64, reg u64 {
  reg u64 f;
  f = z;
  f = inc(f);
  f = f;
  z = z;
  return z, f;
}

fn leaf() {}

export
fn f3(reg u64 a) -> reg u64 {
  a = a;
  leaf();
  return a;
}

export
fn f4(reg u64 a b) -> reg u64 {
  a = a;
  leaf();
  a ^= b;
  return a;
}

fn bot() {}
fn mid() -> reg u64 {
  reg u64 p q;
  p = 1;
  bot();
  q = p;
  bot();
  q ^= p;
  return q;
}

export
fn top() -> reg u64 {
  reg u64 r s t;
  r = 1;
  bot();
  s = r;
  _ = mid();
  t = s;
  bot();
  return t;
}

export
fn main_test (reg u64 x) -> reg u64 {
  reg u64 y;

  y = top();
  x = f1(x, y);
  y, x = f2(y);
  y = f3(y);
  x = f4(x, y);
  y = inc(y);
  x += y;
  return x;
}
