inline fn ble::e () -> reg u64 {
    reg u64 x = 0;
    return x;
}

inline fn ble__e () -> reg u64 {
    reg u64 x = 1;
    return x;
}

export fn out() -> reg u64 {
    reg u64 x = ble::e();
    reg u64 y = ble__e();
    return y;
}

export fn main_test(reg u64 x) -> reg u64 {
  reg u64 a;
  a = out();
  x += a;
  return a;
}
