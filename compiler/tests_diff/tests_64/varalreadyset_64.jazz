inline fn consume(reg u64 x) -> reg u64 {
  if x > 0 {
    x = 0;
  }
  return x;
}

export fn main_aux(reg u64 a) -> reg u64, reg u64 {
  reg u64 x = a;
  reg u64 y = consume(x);
  return x, y;
}

export fn main_test(reg u64 a) -> reg u64 {
  reg u64 x;
  reg u64 y;

  x, y = main_aux(a);

  a += x;
  a -= y;

  return a;
}
