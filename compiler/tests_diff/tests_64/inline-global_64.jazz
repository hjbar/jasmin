u8[10] rcon = { 1, 2, 4, 8, 16, 32, 64, 128, 27, 54 };

inline
fn RCON(inline int i) -> inline int {
  inline int c;
  c = rcon[i - 1];
  return c;
}

export
fn test(reg u64 x) -> reg u64 {
  inline int j v;
  reg u64 r;
  r = x;
  for j = 1 to 11 {
    v = RCON(j);
    r += v;
    v = RCON((rcon[j % 10] % 10) + 1);
    r += v;
  }
  return r;
}

export
fn main_test(reg u64 x) -> reg u64 {
  x = test(x);
  return x;
}
