export
fn main_aux(reg u64 arg) -> reg ui64 {
  arg &= 0x1f;
  reg ui64 result = 1;
  #[spill] reg u64 i = 0;
  while (i < arg) {
    result <<= 1;
    i += 1;
  }
  return result;
}

export
fn xor(reg ptr u64[2] arg) -> reg u64 {
  #[nospill]
  reg u64 x y z;
  x = arg[0];
  y = arg[1];
  z = x ^ y;
  return z;
}

export
fn main_test(reg u64 x) -> reg u64 {
  reg u64 y;
  reg u64 z;
  reg ui64 w;
  stack u64[2] t;

  y = x;
  y *= 5;

  t[0] = x;
  t[1] = y;

  z = xor(t);

  w = main_aux(z);

  x += z;

  return x;
}
