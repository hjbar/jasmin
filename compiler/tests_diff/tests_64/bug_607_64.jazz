fn f(reg ptr u64[1] a, reg u64 x) -> reg ptr u64[1], reg u64 {
    stack ptr u64[1] s;
    s = a;
    a = s;
    return a, x;
}

export
fn main_aux() {
    reg u64 x;
    x = 0;

    stack u64[1] a;
    a[0] = 0;

    if (false) {
        _, _ = f(a, x);
    }
}

export
fn main_test(reg u64 x) -> reg u64 {
  main_aux();
  return x;
}
