/*
Test for all valid integer syntaxes
*/
u64[11] y = {
    0b11110000,
    0b111_111_11,
    0B111_00_11,

    0o01234567,
    0o765_4_321,
    0O76543210,

    1000000000,
    1000_0000_000,

    0x01234567,
    0x765_b_32aac,
    0X76aab3210
};

export fn main_test(reg u64 x) -> reg u64 {
  x += y[0];
  x *= y[1];
  x -= y[2];
  x += y[3];
  x /= y[4];
  x -= y[5];
  x += y[6];
  x *= y[7];
  x /= y[8];
  x -= y[9];
  x += y[10];
  return x;
}
