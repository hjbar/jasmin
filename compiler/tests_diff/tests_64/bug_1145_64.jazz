export fn local_param(reg u64 x) -> reg u64 {
  reg u64 a = x;
  if x <s 0 {
    reg u64 x = 0;
    a += x;
  }
  a += x;
  return a;
}

/* This program terminates ;-) */
export fn loop() -> reg u64 {
  reg u64 x = 1;
  reg u64 c = 0;
  while (x >s 0) { // This refers to the x variable above (from outside the loop body)
    x -= c;
    reg u64 x = 1;
    c = x;
  }
  return x;
}

export fn main_test(reg u64 x) -> reg u64 {
  reg u64 y;
  y = loop();
  x += y;
  return x;
}
