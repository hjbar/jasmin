export fn fail() -> reg u64
{
  stack u64[1] a b;
  reg u64 one;
  one = 1;
  a[0] = one;
  b[0:1] = #copy_32(a);
  reg u64 r;
  r = b[0];
  return r;
}

export fn fail2() -> reg u64
{
  stack u64[1] a b;
  reg u64 one;
  one = 1;
  a[0] = one;
  b = #copy_32(a[0:1]);
  reg u64 r;
  r = b[0];
  return r;
}

export
fn main_test(reg u64 x) -> reg u64 {
  reg u64 a;
  reg u64 b;
  a = fail();
  b = fail2();
  x += a;
  x -= b;
  return x;
}
