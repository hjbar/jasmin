param int n = 4;

inline
fn f(reg u64[n] x) -> reg u64[n] {
reg u64[n] y;
inline int i;
for i = 0 to n { y[i] = x[i]; }
return y;
}

export
fn main_aux(reg u64 a) -> reg u64 {
  reg u64[n] r;
  inline int j;
  for j = 0 to n { r[j] = a; }
  r = f(r);
  reg u64 f;
  f = r[0];
  for j = 1 to n { f ^= r[j]; }
  return f;
}

export
fn main_test(reg u64 a) -> reg u64 {
  a = main_aux(a);
  return a;
}
