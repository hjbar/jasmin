require "utils.jinc"

inline fn update_frame_ref(reg u32 width, reg u32 kernel, reg u32 inputData, reg u32 outputData, reg u32 i, reg u32 j) {
  inline int y, x;
  reg u32 r, g, b;
  reg u32 idx, kernelIdx, weight;

  r = 0;
  g = 0;
  b = 0;

  for y = -1 to 2 {
    for x = -1 to 2 {

      idx = ((j + y) * width + (i + x)) * 4;
      kernelIdx = ((y + 1) * 3 + (x + 1)) * 4;
      weight = [:u32 kernel + kernelIdx];

      r += (32u)[:u8 inputData + idx + 0] * weight;
      g += (32u)[:u8 inputData + idx + 1] * weight;
      b += (32u)[:u8 inputData + idx + 2] * weight;

    }
  }

  idx = (j * width + i) * 4;

  r = max(r, 0);
  r = min(r, 255);

  g = max(g, 0);
  g = min(g, 255);

  b = max(b, 0);
  b = min(b, 255);

  [:u8 outputData + idx + 0] = r;
  [:u8 outputData + idx + 1] = g;
  [:u8 outputData + idx + 2] = b;
  [:u8 outputData + idx + 3] = 255;

}

inline fn update_frame_vec(reg u32 width, reg u32 kernel, reg u32 inputData, reg u32 outputData, reg u32 i, reg u32 j) {
  inline int y, x;
  reg u32 idx, kernelIdx, weight;
  reg u128 v0, v255;
  reg u128 r, g, b, r_32x4, g_32x4, b_32x4, mask_r, mask_g, mask_b;
  reg u128 v_weight, mask_a, pixel_4;

  v0 = #SPLAT_4u32(0);
  v255 = #SPLAT_4u32(255);

  r = 0;
  g = 0;
  b = 0;

  mask_r = (4u32)[0x000000FF, 0x000000FF, 0x000000FF, 0x000000FF];
  mask_g = (4u32)[0x0000FF00, 0x0000FF00, 0x0000FF00, 0x0000FF00];
  mask_b = (4u32)[0x00FF0000, 0x00FF0000, 0x00FF0000, 0x00FF0000];
  mask_a = (4u32)[0xFF000000, 0xFF000000, 0xFF000000, 0xFF000000];

  for y = -1 to 2 {
    for x = -1 to 2 {

      kernelIdx = ((y + 1) * 3 + (x + 1)) * 4;
      weight = [:u32 kernel + kernelIdx];
      v_weight = #SPLAT_4u32(weight);

      idx = ((j + y) * width + (i + x)) * 4;
      pixel_4 = [:u128 inputData + idx];

      r_32x4 = pixel_4 & mask_r;
      g_32x4 = pixel_4 & mask_g;
      g_32x4 = g_32x4 >>4s32 8;
      b_32x4 = pixel_4 & mask_b;
      b_32x4 = b_32x4 >>4s32 16;

      r_32x4 = r_32x4 *4u32 v_weight;
      r = r +4u32 r_32x4;
      g_32x4 = g_32x4 *4u32 v_weight;
      g = g +4u32 g_32x4;
      b_32x4 = b_32x4 *4u32 v_weight;
      b = b +4u32 b_32x4;

    }
  }

  r = #MAX_4s32(r, v0);
  r = #MIN_4s32(r, v255);

  g = #MAX_4s32(g, v0);
  g = #MIN_4s32(g, v255);
  g = g <<4u32 8;

  b = #MAX_4s32(b, v0);
  b = #MIN_4s32(b, v255);
  b = b <<4u32 16;

  pixel_4 = r | g;
  pixel_4 |= b;
  pixel_4 |= mask_a;

  idx = (j * width + i) * 4;
  [:u128 outputData + idx] = pixel_4;

}

export fn inner_computeFrame(reg u32 width, reg u32 height, reg u32 kernel, reg u32 inputData, reg u32 outputData) {
  reg u32 j, i;

  j = 1;
  while (j <32s (height - 1)) {
    i = 1;

    while (i <32s (width - 4)) {

      update_frame_vec(width, kernel, inputData, outputData, i, j);

      i += 4;
    }

    while (i <32s (width - 1)) {

      update_frame_ref(width, kernel, inputData, outputData, i, j);

      i += 1;
    }

    j += 1;
  }

}
