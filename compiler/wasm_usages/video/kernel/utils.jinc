inline fn max(reg u32 a, reg u32 b) -> reg u32 {
  reg u32 res;
  if (a >32s b) {
    res = a;
  } else {
    res = b;
  }
  return res;
}

inline fn min(reg u32 a, reg u32 b) -> reg u32 {
  reg u32 res;
  if (a <32s b) {
    res = a;
  } else {
    res = b;
  }
  return res;
}

inline fn max_4u32(reg u128 a, reg u128 b) -> reg u128 {
  inline int i;
  reg u32 va, vb, tmp;
  reg u128 res;

  res = 0;
  for i=0 to 4 {
    va = #EXTRACT_LANE_4u32(i, a);
    vb = #EXTRACT_LANE_4u32(i, b);
    tmp = max(va, vb);
    res = #REPLACE_LANE_4u32(i, res, tmp);
  }

  return res;
}

inline fn min_4u32(reg u128 a, reg u128 b) -> reg u128 {
  inline int i;
  reg u32 va, vb, tmp;
  reg u128 res;

  res = 0;
  for i=0 to 4 {
    va = #EXTRACT_LANE_4u32(i, a);
    vb = #EXTRACT_LANE_4u32(i, b);
    tmp = min(va, vb);
    res = #REPLACE_LANE_4u32(i, res, tmp);
  }

  return res;
}
